{
  "version": 1,
  "description": "mixed direct 逐 tick 专项，依次校验 all_direct 下 batchWindowTicks=0/1/2 的 single-core runtime 仲裁结果。",
  "defaults": {
    "benchAction": "RunFunctionalCase",
    "matrixPath": "../functional-matrix.json",
    "serverConfigOverrides": {
      "server.command.rateLimit.enabled": "false",
      "server.emitterEdgeMode": "rising",
      "crosschunk.directBatching": "all_direct"
    }
  },
  "entries": [
    {
      "entryId": "x22_mixed_direct_window0",
      "caseId": "mixed_samechunk_direct_window0_tick_assert",
      "serverConfigOverrides": {
        "crosschunk.dispatch.batchWindowTicks": 0
      }
    },
    {
      "entryId": "x23_mixed_direct_window1",
      "caseId": "mixed_samechunk_direct_window1_tick_assert",
      "serverConfigOverrides": {
        "crosschunk.dispatch.batchWindowTicks": 1
      }
    },
    {
      "entryId": "x24_mixed_direct_window2",
      "caseId": "mixed_samechunk_direct_window2_tick_assert",
      "serverConfigOverrides": {
        "crosschunk.dispatch.batchWindowTicks": 2
      }
    }
  ]
}
