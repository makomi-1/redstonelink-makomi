    {
      "entryId": "r05_mixed_restart_verify",
      "caseId": "restart_mixed_replay_redstone_verify",
      "reuseWorldFrom": "x25_mixed_restart_prepare",
      "compareSerialsTo": "x25_mixed_restart_prepare"
    }
  ]
