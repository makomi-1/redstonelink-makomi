{
  "version": 1,
  "description": "游戏内服务器基本权限专项：读控、写控、网页功能权限与权限感知限流。",
  "defaults": {
    "benchAction": "RunFunctionalCase",
    "matrixPath": "../functional-matrix.json"
  },
  "entries": [
    {
      "entryId": "c07_server_permission_read_write",
      "caseId": "server_permission_read_write_basic",
      "serverConfigOverrides": {
        "server.command.permissionLevel": "0",
        "server.command.otherPermissionLevel": "0",
        "server.command.rateLimit.enabled": "false",
        "server.currentLinksPrivacy.mode": "masked",
        "server.currentLinksPrivacy.viewPermissionLevel": "2",
        "server.currentLinksPrivacy.managePermissionLevel": "2",
        "server.linkWriteControl.mode": "limited",
        "server.linkWriteControl.limited.permissionLevel": "2",
        "server.linkWriteControl.limited.maxSetSize": "1",
        "server.linkWriteControl.protected.permissionLevel": "2",
        "server.linkWriteControl.protected.managePermissionLevel": "2"
      }
    },
    {
      "entryId": "c08_server_permission_rate_limit",
      "caseId": "server_permission_rate_limit_basic",
      "serverConfigOverrides": {
        "server.command.permissionLevel": "0",
        "server.command.otherPermissionLevel": "0",
        "server.command.rateLimit.enabled": "true",
        "server.command.rateLimit.windowTicks": "200",
        "server.command.rateLimit.global.capacity": "64",
        "server.command.rateLimit.tier.baseCapacity": "64",
        "server.command.rateLimit.tier.stepPerLevel": "16",
        "server.command.rateLimit.actor.baseCapacity": "64",
        "server.command.rateLimit.actor.stepPerLevel": "16",
        "server.command.rateLimit.actorGroup.other.baseCapacity": "6",
        "server.command.rateLimit.actorGroup.other.stepPerLevel": "4",
        "server.currentLinksPrivacy.mode": "plain",
        "server.linkWriteControl.mode": "full"
      }
    },
    {
      "entryId": "g02_graph_web_permission_gate",
      "caseId": "graph_web_permission_gate_basic",
      "serverConfigOverrides": {
        "server.command.permissionLevel": "0",
        "server.command.otherPermissionLevel": "0",
        "server.command.benchmarkMode.enabled": "true",
        "server.currentLinksPrivacy.mode": "plain",
        "server.web.graph.permissionLevel": "2"
      }
    },
    {
      "entryId": "g03_recording_web_permission_gate",
      "caseId": "recording_web_permission_gate_basic",
      "serverConfigOverrides": {
        "server.command.permissionLevel": "0",
        "server.command.otherPermissionLevel": "0",
        "server.command.benchmarkMode.enabled": "true",
        "server.currentLinksPrivacy.mode": "plain",
        "server.web.recording.permissionLevel": "2"
      }
    }
  ]
}
