{
  "version": 1,
  "description": "x23 mixed direct 同窗口全组合逐 tick 全窗口专项，复用单一参数化 case 依次校验 all_direct 下 batchWindowTicks=0/1/2 的 single-core 组合仲裁结果。",
  "defaults": {
    "benchAction": "RunFunctionalCase",
    "matrixPath": "../functional-matrix.json",
    "serverConfigOverrides": {
      "server.command.rateLimit.enabled": "false",
      "server.emitterEdgeMode": "rising",
      "crosschunk.directBatching": "all_direct"
    }
  },
  "entries": [
    {
      "entryId": "x23_window0",
      "caseId": "mixed_samechunk_direct_combinations_tick_assert",
      "parameters": {
        "dispatchBatchWindowTicks": 0
      },
      "serverConfigOverrides": {
        "crosschunk.dispatch.batchWindowTicks": 0
      }
    },
    {
      "entryId": "x23_window1",
      "caseId": "mixed_samechunk_direct_combinations_tick_assert",
      "parameters": {
        "dispatchBatchWindowTicks": 1
      },
      "serverConfigOverrides": {
        "crosschunk.dispatch.batchWindowTicks": 1
      }
    },
    {
      "entryId": "x23_window2",
      "caseId": "mixed_samechunk_direct_combinations_tick_assert",
      "parameters": {
        "dispatchBatchWindowTicks": 2
      },
      "serverConfigOverrides": {
        "crosschunk.dispatch.batchWindowTicks": 2
      }
    }
  ]
}
