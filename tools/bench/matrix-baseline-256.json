{
  "version": 1,
  "defaults": {
    "tickMillis": 50,
    "settleTicks": 20,
    "prepareFunctions": [
      "rl_bench:prepare/common",
      "rl_bench:reset/common"
    ],
    "resultsDir": "run/profiles/bench-results-baseline-256",
    "spark": {
      "startCpu": "spark profiler start",
      "stopCpu": "spark profiler stop --comment {case_id}",
      "health": "spark health --upload --memory"
    }
  },
  "templatePaths": [
    "templates/performance/drive.json"
  ],
  "casePaths": [
    "cases/performance/p10/sync_256_to_256_core_banded16.json",
    "cases/performance/p11/mixed_256_to_256_core_banded16.json"
  ]
}
