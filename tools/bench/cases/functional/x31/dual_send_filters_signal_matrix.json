{
  "id": "dual_send_filters_signal_matrix",
  "description": "验证 2s 组合下，两个 send 过滤器叠加后，7 通过、12 仅被 upper_bound send 拦截、3 仅被 lower_bound send 拦截。",
  "layer": "X",
  "scenarioId": "X31",
  "arena": {
    "clearFrom": [-8, 63, 700],
    "clearTo": [24, 66, 710]
  },
  "targets": {
    "id": "core_dual_send_filters",
    "kind": "core_block",
    "layout": {
      "shape": "cuboid",
      "from": [20, 64, 704],
      "to": [20, 64, 704]
    }
  },
  "sources": [
    {
      "id": "sync_dual_send_filters",
      "kind": "sync_emitter",
      "layout": {
        "shape": "cuboid",
        "from": [0, 64, 704],
        "to": [0, 64, 704]
      }
    }
  ],
  "links": [
    {
      "sourceGroup": "sync_dual_send_filters",
      "mapping": "fan_in_first"
    }
  ],
  "phases": [
    {
      "templateRef": "trace_mount_core_slash",
      "name": "mount_dual_send_filters_target"
    },
    {
      "templateRef": "command_assert",
      "name": "place_dual_send_filters_a_support",
      "command": "setblock 2 63 705 minecraft:stone",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "place_dual_send_filters_b_support",
      "command": "setblock 4 63 705 minecraft:stone",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "place_dual_send_filters_a",
      "command": "setblock 2 64 704 redstonelink:link_send_filter",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "place_dual_send_filters_b",
      "command": "setblock 4 64 704 redstonelink:link_send_filter",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "power_dual_send_filters_a_neighbor",
      "command": "setblock 2 64 705 minecraft:redstone_block",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "power_dual_send_filters_b_neighbor",
      "command": "setblock 4 64 705 minecraft:redstone_block",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_dual_send_filters_attach",
      "ticks": 4
    },
    {
      "templateRef": "command_assert",
      "name": "configure_dual_send_filters_upper_bound",
      "commandTemplate": "data merge block 2 64 704 {serialExpression:\"\",nodeSetMode:\"disabled\",signalThresholdSource:\"fixed_input\",fixedSignalThreshold:10,signalMode:\"upper_bound\"}",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "configure_dual_send_filters_lower_bound",
      "commandTemplate": "data merge block 4 64 704 {serialExpression:\"\",nodeSetMode:\"disabled\",signalThresholdSource:\"fixed_input\",fixedSignalThreshold:5,signalMode:\"lower_bound\"}",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "refresh_dual_send_filters_a_drop_neighbor",
      "command": "setblock 2 64 705 minecraft:air",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "refresh_dual_send_filters_a_restore_neighbor",
      "command": "setblock 2 64 705 minecraft:redstone_block",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "refresh_dual_send_filters_b_drop_neighbor",
      "command": "setblock 4 64 705 minecraft:air",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "refresh_dual_send_filters_b_restore_neighbor",
      "command": "setblock 4 64 705 minecraft:redstone_block",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_dual_send_filters_runtime_refresh",
      "ticks": 4
    },
    {
      "templateRef": "input_start_custom_triggerSource",
      "name": "start_dual_send_filters_signal_seven",
      "serialRef": "sync_dual_send_filters",
      "serialFormat": "slash_list",
      "sequence": "7",
      "phaseTicks": 0,
      "totalTicks": 0
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_dual_send_filters_signal_seven",
      "ticks": 4
    },
    {
      "templateRef": "trace_latest_assert_core",
      "name": "dual_send_filters_signal_seven_should_pass_both_send_filters",
      "serialFormat": "slash_list",
      "expect": {
        "active": true,
        "effectiveMode": "sync",
        "resolvedStrength": 7
      }
    },
    {
      "templateRef": "input_clear",
      "name": "clear_dual_send_filters_signal_seven"
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_dual_send_filters_signal_seven_clear",
      "ticks": 4
    },
    {
      "templateRef": "input_start_custom_triggerSource",
      "name": "start_dual_send_filters_signal_twelve",
      "serialRef": "sync_dual_send_filters",
      "serialFormat": "slash_list",
      "sequence": "12",
      "phaseTicks": 0,
      "totalTicks": 0
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_dual_send_filters_signal_twelve",
      "ticks": 4
    },
    {
      "templateRef": "trace_latest_assert_core",
      "name": "dual_send_filters_signal_twelve_should_be_blocked_by_upper_bound_send",
      "serialFormat": "slash_list",
      "expect": {
        "active": false,
        "effectiveMode": "none",
        "resolvedStrength": 0
      }
    },
    {
      "templateRef": "input_clear",
      "name": "clear_dual_send_filters_signal_twelve"
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_dual_send_filters_signal_twelve_clear",
      "ticks": 4
    },
    {
      "templateRef": "input_start_custom_triggerSource",
      "name": "start_dual_send_filters_signal_three",
      "serialRef": "sync_dual_send_filters",
      "serialFormat": "slash_list",
      "sequence": "3",
      "phaseTicks": 0,
      "totalTicks": 0
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_dual_send_filters_signal_three",
      "ticks": 4
    },
    {
      "templateRef": "trace_latest_assert_core",
      "name": "dual_send_filters_signal_three_should_be_blocked_by_lower_bound_send",
      "serialFormat": "slash_list",
      "expect": {
        "active": false,
        "effectiveMode": "none",
        "resolvedStrength": 0
      }
    },
    {
      "templateRef": "input_clear",
      "name": "clear_dual_send_filters_signal_three"
    },
    {
      "templateRef": "trace_unmount_core_slash",
      "name": "unmount_dual_send_filters_target"
    }
  ]
}
