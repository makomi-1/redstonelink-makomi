{
  "id": "dual_filter_1s1r_signal_matrix",
  "description": "验证 1s1r 组合下，send upper_bound 与 receive lower_bound 叠加后，7 通过、12 仅被 send 拦截、3 仅被 receive 拦截。",
  "layer": "X",
  "scenarioId": "X29",
  "arena": {
    "clearFrom": [-8, 63, 660],
    "clearTo": [24, 66, 670]
  },
  "targets": {
    "id": "core_dual_filter_1s1r",
    "kind": "core_block",
    "layout": {
      "shape": "cuboid",
      "from": [20, 64, 664],
      "to": [20, 64, 664]
    }
  },
  "sources": [
    {
      "id": "sync_dual_filter_1s1r",
      "kind": "sync_emitter",
      "layout": {
        "shape": "cuboid",
        "from": [0, 64, 664],
        "to": [0, 64, 664]
      }
    }
  ],
  "links": [
    {
      "sourceGroup": "sync_dual_filter_1s1r",
      "mapping": "fan_in_first"
    }
  ],
  "phases": [
    {
      "templateRef": "trace_mount_core_slash",
      "name": "mount_dual_filter_1s1r_target"
    },
    {
      "templateRef": "command_assert",
      "name": "place_dual_filter_1s1r_send_support",
      "command": "setblock 2 63 665 minecraft:stone",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "place_dual_filter_1s1r_receive_support",
      "command": "setblock 14 63 665 minecraft:stone",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "place_dual_filter_1s1r_send_filter",
      "command": "setblock 2 64 664 redstonelink:link_send_filter",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "place_dual_filter_1s1r_receive_filter",
      "command": "setblock 14 64 664 redstonelink:link_receive_filter",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "power_dual_filter_1s1r_send_neighbor",
      "command": "setblock 2 64 665 minecraft:redstone_block",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "power_dual_filter_1s1r_receive_neighbor",
      "command": "setblock 14 64 665 minecraft:redstone_block",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_dual_filter_1s1r_filters_attach",
      "ticks": 4
    },
    {
      "templateRef": "command_assert",
      "name": "configure_dual_filter_1s1r_send_upper_bound",
      "command": "data merge block 2 64 664 {serialExpression:\"\",nodeSetMode:\"disabled\",signalThresholdSource:\"fixed_input\",fixedSignalThreshold:10,signalMode:\"upper_bound\"}",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "configure_dual_filter_1s1r_receive_lower_bound",
      "command": "data merge block 14 64 664 {serialExpression:\"\",nodeSetMode:\"disabled\",signalThresholdSource:\"fixed_input\",fixedSignalThreshold:5,signalMode:\"lower_bound\"}",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "refresh_dual_filter_1s1r_send_drop_neighbor",
      "command": "setblock 2 64 665 minecraft:air",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "refresh_dual_filter_1s1r_send_restore_neighbor",
      "command": "setblock 2 64 665 minecraft:redstone_block",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "refresh_dual_filter_1s1r_receive_drop_neighbor",
      "command": "setblock 14 64 665 minecraft:air",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "refresh_dual_filter_1s1r_receive_restore_neighbor",
      "command": "setblock 14 64 665 minecraft:redstone_block",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_dual_filter_1s1r_runtime_refresh",
      "ticks": 4
    },
    {
      "templateRef": "input_start_custom_triggerSource",
      "name": "start_dual_filter_1s1r_signal_seven",
      "serialRef": "sync_dual_filter_1s1r",
      "serialFormat": "slash_list",
      "sequence": "7",
      "phaseTicks": 0,
      "totalTicks": 0
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_dual_filter_1s1r_signal_seven",
      "ticks": 4
    },
    {
      "templateRef": "trace_latest_assert_core",
      "name": "dual_filter_1s1r_signal_seven_should_pass_both_filters",
      "serialFormat": "slash_list",
      "expect": {
        "active": true,
        "effectiveMode": "sync",
        "resolvedStrength": 7
      }
    },
    {
      "templateRef": "input_clear",
      "name": "clear_dual_filter_1s1r_signal_seven"
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_dual_filter_1s1r_signal_seven_clear",
      "ticks": 4
    },
    {
      "templateRef": "input_start_custom_triggerSource",
      "name": "start_dual_filter_1s1r_signal_twelve",
      "serialRef": "sync_dual_filter_1s1r",
      "serialFormat": "slash_list",
      "sequence": "12",
      "phaseTicks": 0,
      "totalTicks": 0
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_dual_filter_1s1r_signal_twelve",
      "ticks": 4
    },
    {
      "templateRef": "trace_latest_assert_core",
      "name": "dual_filter_1s1r_signal_twelve_should_be_blocked_by_send_only",
      "serialFormat": "slash_list",
      "expect": {
        "active": false,
        "effectiveMode": "none",
        "resolvedStrength": 0
      }
    },
    {
      "templateRef": "input_clear",
      "name": "clear_dual_filter_1s1r_signal_twelve"
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_dual_filter_1s1r_signal_twelve_clear",
      "ticks": 4
    },
    {
      "templateRef": "input_start_custom_triggerSource",
      "name": "start_dual_filter_1s1r_signal_three",
      "serialRef": "sync_dual_filter_1s1r",
      "serialFormat": "slash_list",
      "sequence": "3",
      "phaseTicks": 0,
      "totalTicks": 0
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_dual_filter_1s1r_signal_three",
      "ticks": 4
    },
    {
      "templateRef": "trace_latest_assert_core",
      "name": "dual_filter_1s1r_signal_three_should_be_blocked_by_receive_only",
      "serialFormat": "slash_list",
      "expect": {
        "active": false,
        "effectiveMode": "none",
        "resolvedStrength": 0
      }
    },
    {
      "templateRef": "input_clear",
      "name": "clear_dual_filter_1s1r_signal_three"
    },
    {
      "templateRef": "trace_unmount_core_slash",
      "name": "unmount_dual_filter_1s1r_target"
    }
  ]
}
