{
  "id": "occ_pairing_core_conflict",
  "description": "读取 core baseline 后插入一次真实改动，再用 stale coreRevision 提交 core pairing，确认冲突不会回滚最新拓扑。",
  "layer": "O",
  "scenarioId": "O02",
  "arena": {
    "clearFrom": [-8, 63, 138],
    "clearTo": [24, 66, 146]
  },
  "targets": {
    "id": "core_occ_pairing_core_conflict",
    "kind": "core_block",
    "layout": {
      "shape": "cuboid",
      "from": [12, 64, 140],
      "to": [12, 64, 140]
    }
  },
  "sources": [
    {
      "id": "sync_occ_pairing_core_conflict",
      "kind": "sync_emitter",
      "layout": {
        "shape": "cuboid",
        "from": [0, 64, 140],
        "to": [1, 64, 140]
      }
    }
  ],
  "links": [],
  "phases": [
    {
      "templateRef": "command_assert",
      "name": "snapshot_core_baseline",
      "commandTemplate": "redstonelink bench occ snapshot core {{targets[0]}}",
      "expectedPrefix": "[RedstoneLink/Bench]",
      "expectedRegexes": [
        "(?i)occ_snapshot",
        "(?i)type=core"
      ],
      "captureRegex": "graphRevision=(?<graphRevision>\\d+)\\s+sourceRevision=(?<sourceRevision>\\d+)\\s+coreRevision=(?<coreRevision>\\d+)"
    },
    {
      "templateRef": "command_assert",
      "name": "mutate_core_membership_via_source_a",
      "commandTemplate": "redstonelink link set triggerSource {{source:sync_occ_pairing_core_conflict[0]}} {{targets[0]:mixed}} confirm",
      "expectedPrefix": "[RedstoneLink]",
      "expectedRegex": "(?i)(Links replaced|连接已替换)"
    },
    {
      "templateRef": "command_assert",
      "name": "submit_stale_core_pairing",
      "commandTemplate": "redstonelink bench occ pairing submit core {{targets[0]}} triggerSource {{source:sync_occ_pairing_core_conflict[1]:mixed}} expectedCoreRevision={{phase:snapshot_core_baseline.captures.coreRevision}}",
      "expectedPrefix": "[RedstoneLink/Bench]",
      "expectedRegexes": [
        "(?i)occ_pairing_submit",
        "(?i)outcome=conflict",
        "(?i)messageKey=message\\.redstonelink\\.pairing\\.conflict\\.core_revision",
        "(?i)currentTargetCount=1"
      ]
    },
    {
      "templateRef": "command_assert",
      "name": "verify_source_a_kept_latest_link",
      "commandTemplate": "redstonelink link get triggerSource {{source:sync_occ_pairing_core_conflict[0]}}",
      "expectedPrefix": "[RedstoneLink/Link]",
      "expectedRegexes": [
        "(?i)(target_count=1|目标数=1)",
        "(?i)(targets=|目标列表=)[^\\r\\n]*?(?<!\\d){{targets[0]}}(?!\\d)"
      ]
    },
    {
      "templateRef": "command_assert",
      "name": "verify_source_b_not_overwritten",
      "commandTemplate": "redstonelink link get triggerSource {{source:sync_occ_pairing_core_conflict[1]}}",
      "expectedPrefix": "[RedstoneLink/Link]",
      "expectedRegexes": [
        "(?i)(target_count=0|目标数=0)",
        "(?i)(targets=-|目标列表=-)"
      ],
      "rejectRegex": "(?i)(targets=|目标列表=)[^\\r\\n]*?(?<!\\d){{targets[0]}}(?!\\d)"
    }
  ]
}
