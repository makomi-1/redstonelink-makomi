{
  "id": "restart_persist_toggle_verify",
  "description": "复用已存在世界，验证重启后 serial、链接与 toggle 最终态仍一致。",
  "layer": "R",
  "scenarioId": "R02",
  "clearArena": false,
  "arena": {
    "clearFrom": [-8, 63, 70],
    "clearTo": [24, 66, 78]
  },
  "targets": {
    "id": "core_restart",
    "kind": "core_block",
    "reuseExisting": true,
    "layout": {
      "shape": "cuboid",
      "from": [12, 64, 72],
      "to": [12, 64, 72]
    }
  },
  "sources": [
    {
      "id": "toggle_restart",
      "kind": "toggle_emitter",
      "reuseExisting": true,
      "layout": {
        "shape": "cuboid",
        "from": [0, 64, 72],
        "to": [0, 64, 72]
      }
    }
  ],
  "links": [],
  "phases": [
    {
      "templateRef": "trace_mount_core_slash",
      "name": "mount_restart_target_verify"
    },
    {
      "templateRef": "wait_ticks",
      "name": "collect_restart_verify_mount_ticks",
      "ticks": 2
    },
    {
      "templateRef": "link_command",
      "name": "restart_verify_link_get",
      "action": "get",
      "sourceRef": "toggle_restart"
    },
    {
      "templateRef": "trace_latest_assert_core",
      "name": "restart_verify_target_should_stay_on",
      "serialFormat": "slash_list",
      "expect": {
        "active": true
      }
    },
    {
      "templateRef": "activate_batch_toggle",
      "name": "restart_verify_toggle_again",
      "serialRef": "toggle_restart",
      "serialFormat": "slash_list"
    },
    {
      "templateRef": "wait_ticks",
      "name": "collect_restart_verify_toggle_ticks",
      "ticks": 3
    },
    {
      "templateRef": "trace_latest_assert_core",
      "name": "restart_verify_target_should_turn_off",
      "serialFormat": "slash_list",
      "expect": {
        "active": false
      }
    },
    {
      "templateRef": "trace_unmount_core_slash",
      "name": "unmount_restart_target_verify"
    }
  ]
}
