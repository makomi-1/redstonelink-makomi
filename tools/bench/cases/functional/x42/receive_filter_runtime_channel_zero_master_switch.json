{
  "id": "receive_filter_runtime_channel_zero_master_switch",
  "description": "验证 receive 频道过滤器在邻居输入为 0 时作为总开关关闭，并在恢复非零后重新生效。",
  "layer": "X",
  "scenarioId": "X42",
  "arena": {
    "clearFrom": [-8, 63, 800],
    "clearTo": [20, 66, 810]
  },
  "targets": {
    "id": "core_receive_filter_channel_zero_switch",
    "kind": "core_block",
    "layout": {
      "shape": "cuboid",
      "from": [12, 64, 804],
      "to": [12, 64, 804]
    }
  },
  "sources": [
    {
      "id": "sync_receive_filter_channel_zero_switch",
      "kind": "sync_emitter",
      "layout": {
        "shape": "cuboid",
        "from": [0, 64, 804],
        "to": [0, 64, 804]
      }
    }
  ],
  "links": [],
  "phases": [
    {
      "templateRef": "trace_mount_core_slash",
      "name": "mount_receive_filter_channel_zero_switch_target"
    },
    {
      "templateRef": "command_assert",
      "name": "place_receive_filter_channel_zero_switch_block",
      "command": "setblock 10 64 804 redstonelink:link_receive_filter",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "power_receive_filter_channel_zero_switch_neighbor_high",
      "command": "setblock 10 64 805 minecraft:redstone_block",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_receive_filter_channel_zero_switch_attach",
      "ticks": 4
    },
    {
      "templateRef": "command_assert",
      "name": "snapshot_receive_filter_channel_zero_switch_core_baseline",
      "commandTemplate": "redstonelink bench occ snapshot core {{targets[0]}}",
      "expectedPrefix": "[RedstoneLink/Bench]",
      "expectedRegexes": [
        "(?i)occ_snapshot",
        "(?i)type=core"
      ],
      "captureRegex": "graphRevision=(?<graphRevision>\\d+)\\s+sourceRevision=(?<sourceRevision>\\d+)\\s+coreRevision=(?<coreRevision>\\d+)"
    },
    {
      "templateRef": "command_assert",
      "name": "submit_receive_filter_channel_zero_switch_core_channel",
      "commandTemplate": "redstonelink bench occ pairing submit core {{targets[0]}} triggerSource channel 121 expectedCoreRevision={{phase:snapshot_receive_filter_channel_zero_switch_core_baseline.captures.coreRevision}}",
      "expectedPrefix": "[RedstoneLink/Bench]",
      "expectedRegexes": [
        "(?i)occ_pairing_submit",
        "(?i)outcome=applied",
        "(?i)type=core"
      ]
    },
    {
      "templateRef": "command_assert",
      "name": "snapshot_receive_filter_channel_zero_switch_source_baseline",
      "commandTemplate": "redstonelink bench occ snapshot triggerSource {{source:sync_receive_filter_channel_zero_switch[0]}}",
      "expectedPrefix": "[RedstoneLink/Bench]",
      "expectedRegexes": [
        "(?i)occ_snapshot",
        "(?i)type=triggerSource"
      ],
      "captureRegex": "graphRevision=(?<graphRevision>\\d+)\\s+sourceRevision=(?<sourceRevision>\\d+)"
    },
    {
      "templateRef": "command_assert",
      "name": "submit_receive_filter_channel_zero_switch_source_channel",
      "commandTemplate": "redstonelink bench occ pairing submit triggerSource {{source:sync_receive_filter_channel_zero_switch[0]}} core channel 121 expectedSourceRevision={{phase:snapshot_receive_filter_channel_zero_switch_source_baseline.captures.sourceRevision}}",
      "expectedPrefix": "[RedstoneLink/Bench]",
      "expectedRegexes": [
        "(?i)occ_pairing_submit",
        "(?i)outcome=applied",
        "(?i)type=triggerSource"
      ]
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_receive_filter_channel_zero_switch_channel_apply",
      "ticks": 4
    },
    {
      "templateRef": "command_assert",
      "name": "configure_receive_filter_channel_zero_switch_blocklist_target",
      "command": "data merge block 10 64 804 {serialExpression:\"\",targetMode:\"channel\",channel:121L,nodeSetMode:\"blocklist\",signalThresholdSource:\"fixed_input\",fixedSignalThreshold:15,signalMode:\"disabled\"}",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_receive_filter_channel_zero_switch_config",
      "ticks": 4
    },
    {
      "templateRef": "command_assert",
      "name": "refresh_receive_filter_channel_zero_switch_drop_neighbor_for_config",
      "command": "setblock 10 64 805 minecraft:air",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "refresh_receive_filter_channel_zero_switch_restore_neighbor_after_config",
      "command": "setblock 10 64 805 minecraft:redstone_block",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_receive_filter_channel_zero_switch_config_refresh",
      "ticks": 4
    },
    {
      "templateRef": "input_start_custom_triggerSource",
      "name": "start_receive_filter_channel_zero_switch_source_high",
      "serialRef": "sync_receive_filter_channel_zero_switch",
      "serialFormat": "slash_list",
      "sequence": "15",
      "phaseTicks": 0,
      "totalTicks": 0
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_receive_filter_channel_zero_switch_source_high",
      "ticks": 4
    },
    {
      "templateRef": "trace_latest_assert_core",
      "name": "receive_filter_channel_zero_switch_target_should_stay_low_while_blocklist_is_enabled",
      "serialFormat": "slash_list",
      "expect": {
        "active": false,
        "effectiveMode": "none",
        "resolvedStrength": 0
      }
    },
    {
      "templateRef": "command_assert",
      "name": "drop_receive_filter_channel_zero_switch_neighbor_to_zero",
      "command": "setblock 10 64 805 minecraft:air",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_receive_filter_channel_zero_switch_neighbor_zero",
      "ticks": 4
    },
    {
      "templateRef": "trace_latest_assert_core",
      "name": "receive_filter_channel_zero_switch_target_should_replay_when_zero_disables_filter",
      "serialFormat": "slash_list",
      "expect": {
        "active": true,
        "effectiveMode": "sync",
        "resolvedStrength": 15
      }
    },
    {
      "templateRef": "command_assert",
      "name": "restore_receive_filter_channel_zero_switch_neighbor_high",
      "command": "setblock 10 64 805 minecraft:redstone_block",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_receive_filter_channel_zero_switch_neighbor_restore",
      "ticks": 4
    },
    {
      "templateRef": "trace_latest_assert_core",
      "name": "receive_filter_channel_zero_switch_target_should_invalidate_again_when_neighbor_restores",
      "serialFormat": "slash_list",
      "expect": {
        "active": false,
        "effectiveMode": "none",
        "resolvedStrength": 0
      }
    },
    {
      "templateRef": "input_clear",
      "name": "clear_receive_filter_channel_zero_switch_jobs"
    },
    {
      "templateRef": "trace_unmount_core_slash",
      "name": "unmount_receive_filter_channel_zero_switch_target"
    }
  ]
}
