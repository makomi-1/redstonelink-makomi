{
  "id": "send_filter_runtime_channel_zero_master_switch",
  "description": "验证 send 频道过滤器在邻居输入为 0 时作为总开关关闭，并在恢复非零后重新生效。",
  "layer": "X",
  "scenarioId": "X41",
  "arena": {
    "clearFrom": [-8, 63, 780],
    "clearTo": [20, 66, 790]
  },
  "targets": {
    "id": "core_send_filter_channel_zero_switch",
    "kind": "core_block",
    "layout": {
      "shape": "cuboid",
      "from": [12, 64, 784],
      "to": [12, 64, 784]
    }
  },
  "sources": [
    {
      "id": "sync_send_filter_channel_zero_switch",
      "kind": "sync_emitter",
      "layout": {
        "shape": "cuboid",
        "from": [0, 64, 784],
        "to": [0, 64, 784]
      }
    }
  ],
  "links": [],
  "phases": [
    {
      "templateRef": "trace_mount_core_slash",
      "name": "mount_send_filter_channel_zero_switch_target"
    },
    {
      "templateRef": "command_assert",
      "name": "place_send_filter_channel_zero_switch_block",
      "command": "setblock 2 64 784 redstonelink:link_send_filter",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "power_send_filter_channel_zero_switch_neighbor_high",
      "command": "setblock 2 64 785 minecraft:redstone_block",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_send_filter_channel_zero_switch_attach",
      "ticks": 4
    },
    {
      "templateRef": "command_assert",
      "name": "snapshot_send_filter_channel_zero_switch_core_baseline",
      "commandTemplate": "redstonelink bench occ snapshot core {{targets[0]}}",
      "expectedPrefix": "[RedstoneLink/Bench]",
      "expectedRegexes": [
        "(?i)occ_snapshot",
        "(?i)type=core"
      ],
      "captureRegex": "graphRevision=(?<graphRevision>\\d+)\\s+sourceRevision=(?<sourceRevision>\\d+)\\s+coreRevision=(?<coreRevision>\\d+)"
    },
    {
      "templateRef": "command_assert",
      "name": "submit_send_filter_channel_zero_switch_core_channel",
      "commandTemplate": "redstonelink bench occ pairing submit core {{targets[0]}} triggerSource channel 111 expectedCoreRevision={{phase:snapshot_send_filter_channel_zero_switch_core_baseline.captures.coreRevision}}",
      "expectedPrefix": "[RedstoneLink/Bench]",
      "expectedRegexes": [
        "(?i)occ_pairing_submit",
        "(?i)outcome=applied",
        "(?i)type=core"
      ]
    },
    {
      "templateRef": "command_assert",
      "name": "snapshot_send_filter_channel_zero_switch_source_baseline",
      "commandTemplate": "redstonelink bench occ snapshot triggerSource {{source:sync_send_filter_channel_zero_switch[0]}}",
      "expectedPrefix": "[RedstoneLink/Bench]",
      "expectedRegexes": [
        "(?i)occ_snapshot",
        "(?i)type=triggerSource"
      ],
      "captureRegex": "graphRevision=(?<graphRevision>\\d+)\\s+sourceRevision=(?<sourceRevision>\\d+)"
    },
    {
      "templateRef": "command_assert",
      "name": "submit_send_filter_channel_zero_switch_source_channel",
      "commandTemplate": "redstonelink bench occ pairing submit triggerSource {{source:sync_send_filter_channel_zero_switch[0]}} core channel 111 expectedSourceRevision={{phase:snapshot_send_filter_channel_zero_switch_source_baseline.captures.sourceRevision}}",
      "expectedPrefix": "[RedstoneLink/Bench]",
      "expectedRegexes": [
        "(?i)occ_pairing_submit",
        "(?i)outcome=applied",
        "(?i)type=triggerSource"
      ]
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_send_filter_channel_zero_switch_channel_apply",
      "ticks": 4
    },
    {
      "templateRef": "command_assert",
      "name": "configure_send_filter_channel_zero_switch_blocklist_source",
      "command": "data merge block 2 64 784 {serialExpression:\"\",targetMode:\"channel\",channel:111L,nodeSetMode:\"blocklist\",signalThresholdSource:\"fixed_input\",fixedSignalThreshold:15,signalMode:\"disabled\"}",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_send_filter_channel_zero_switch_config",
      "ticks": 4
    },
    {
      "templateRef": "command_assert",
      "name": "refresh_send_filter_channel_zero_switch_drop_neighbor_for_config",
      "command": "setblock 2 64 785 minecraft:air",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "command_assert",
      "name": "refresh_send_filter_channel_zero_switch_restore_neighbor_after_config",
      "command": "setblock 2 64 785 minecraft:redstone_block",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_send_filter_channel_zero_switch_config_refresh",
      "ticks": 4
    },
    {
      "templateRef": "input_start_custom_triggerSource",
      "name": "start_send_filter_channel_zero_switch_source_high",
      "serialRef": "sync_send_filter_channel_zero_switch",
      "serialFormat": "slash_list",
      "sequence": "15",
      "phaseTicks": 0,
      "totalTicks": 0
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_send_filter_channel_zero_switch_source_high",
      "ticks": 4
    },
    {
      "templateRef": "trace_latest_assert_core",
      "name": "send_filter_channel_zero_switch_target_should_stay_low_while_blocklist_is_enabled",
      "serialFormat": "slash_list",
      "expect": {
        "active": false,
        "effectiveMode": "none",
        "resolvedStrength": 0
      }
    },
    {
      "templateRef": "command_assert",
      "name": "drop_send_filter_channel_zero_switch_neighbor_to_zero",
      "command": "setblock 2 64 785 minecraft:air",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_send_filter_channel_zero_switch_neighbor_zero",
      "ticks": 4
    },
    {
      "templateRef": "trace_latest_assert_core",
      "name": "send_filter_channel_zero_switch_target_should_replay_when_zero_disables_filter",
      "serialFormat": "slash_list",
      "expect": {
        "active": true,
        "effectiveMode": "sync",
        "resolvedStrength": 15
      }
    },
    {
      "templateRef": "command_assert",
      "name": "restore_send_filter_channel_zero_switch_neighbor_high",
      "command": "setblock 2 64 785 minecraft:redstone_block",
      "allowEmptyResponse": true
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_send_filter_channel_zero_switch_neighbor_restore",
      "ticks": 4
    },
    {
      "templateRef": "trace_latest_assert_core",
      "name": "send_filter_channel_zero_switch_target_should_invalidate_again_when_neighbor_restores",
      "serialFormat": "slash_list",
      "expect": {
        "active": false,
        "effectiveMode": "none",
        "resolvedStrength": 0
      }
    },
    {
      "templateRef": "input_clear",
      "name": "clear_send_filter_channel_zero_switch_jobs"
    },
    {
      "templateRef": "trace_unmount_core_slash",
      "name": "unmount_send_filter_channel_zero_switch_target"
    }
  ]
}
