{
  "id": "restart_mixed_replay_redstone_verify",
  "description": "复用 mixed 红石块并发场景，重启后先验证 sync 恢复，再通过移除 sync emitter 验证最新简化模型下目标不会回落到事件信号，而是直接归零。",
  "layer": "R",
  "scenarioId": "R05",
  "clearArena": false,
  "arena": {
    "clearFrom": [-8, 63, 560],
    "clearTo": [20, 66, 568]
  },
  "targets": {
    "id": "core_mixed_restart",
    "kind": "core_block",
    "reuseExisting": true,
    "layout": {
      "shape": "cuboid",
      "from": [12, 64, 561],
      "to": [12, 64, 561]
    }
  },
  "sources": [
    {
      "id": "sync_mixed_restart",
      "kind": "sync_emitter",
      "reuseExisting": true,
      "layout": {
        "shape": "cuboid",
        "from": [0, 64, 560],
        "to": [0, 64, 560]
      }
    },
    {
      "id": "pulse_mixed_restart",
      "kind": "pulse_emitter",
      "reuseExisting": true,
      "layout": {
        "shape": "cuboid",
        "from": [0, 64, 561],
        "to": [0, 64, 561]
      }
    },
    {
      "id": "toggle_mixed_restart",
      "kind": "toggle_emitter",
      "reuseExisting": true,
      "layout": {
        "shape": "cuboid",
        "from": [0, 64, 562],
        "to": [0, 64, 562]
      }
    }
  ],
  "links": [],
  "phases": [
    {
      "templateRef": "trace_mount_core_slash",
      "name": "mount_mixed_restart_target_verify"
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_mixed_restart_verify_mount_ticks",
      "ticks": 2
    },
    {
      "templateRef": "trace_latest_assert_core",
      "name": "mixed_restart_verify_target_should_recover_sync",
      "serialFormat": "slash_list",
      "expect": {
        "active": true,
        "effectiveMode": "sync",
        "resolvedStrength": 15
      }
    },
    {
      "templateRef": "command_assert",
      "name": "remove_sync_mixed_restart_emitter",
      "command": "setblock 0 64 560 minecraft:air",
      "captureTickWindow": true,
      "allowEmptyResponse": true
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_after_remove_sync_mixed_restart_settle",
      "ticks": 2
    },
    {
      "templateRef": "trace_latest_assert_core",
      "name": "mixed_restart_verify_target_should_clear_after_sync_removed",
      "serialFormat": "slash_list",
      "expect": {
        "active": false,
        "effectiveMode": "none",
        "resolvedStrength": 0
      }
    },
    {
      "templateRef": "command_assert",
      "name": "remove_toggle_mixed_restart_emitter",
      "command": "setblock 0 64 562 minecraft:air",
      "captureTickWindow": true,
      "allowEmptyResponse": true
    },
    {
      "templateRef": "wait_ticks",
      "name": "wait_after_remove_toggle_mixed_restart",
      "ticks": 3
    },
    {
      "templateRef": "trace_latest_assert_core",
      "name": "mixed_restart_verify_target_should_turn_off",
      "serialFormat": "slash_list",
      "expect": {
        "active": false,
        "effectiveMode": "none",
        "resolvedStrength": 0
      }
    },
    {
      "templateRef": "trace_unmount_core_slash",
      "name": "unmount_mixed_restart_target_verify"
    }
  ]
}
