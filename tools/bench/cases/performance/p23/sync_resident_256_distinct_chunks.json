      }
    }
  ],
  "links": [
    {
      "sourceGroup": "sync_p23_resident",
      "mapping": "broadcast_all",
      "targetSerialFormat": "range"
    }
  ],
  "drive": {
    "totalTicks": 270,
    "steps": [
      {
        "templateRef": "command_assert",
        "name": "resident_set_targets",
        "commandTemplate": "redstonelink crosschunk whitelist set target core {{targets:range}} resident confirm",
        "expectedPrefix": "[RedstoneLink/CrossChunk]",
        "expectedRegex": "(?i)(Whitelist overwritten|白名单已覆盖)"
      },
      {
        "templateRef": "wait_ticks",
        "name": "wait_resident_ticket_sync",
        "ticks": 10
      },
      {
        "templateRef": "command_assert",
        "name": "remove_setup_forceload_targets",
        "command": "forceload remove 4616 4616 4856 4856",
        "commandDimension": "minecraft:the_nether"
      },
      {
        "templateRef": "wait_ticks",
        "name": "wait_resident_handoff",
        "ticks": 20
      },
      {
        "templateRef": "command_assert",
        "name": "resident_target_should_stay_online",
        "commandTemplate": "redstonelink node get core {{targets[0]}}",
        "expectedPrefix": "[RedstoneLink/Node]",
        "expectedRegexes": [
          "(?i)(online=true|在线=true)",
          "(?i)minecraft:the_nether"
        ]
      },
      {
        "templateRef": "input_start_square_triggerSource",
        "name": "start_resident_square",
        "serialRef": "sync_p23_resident",
        "serialFormat": "slash_list",
        "periodTicks": 40,
        "highTicks": 20,
        "highPower": 15,
        "lowPower": 0,
        "phaseTicks": 0,
        "totalTicks": 240
      },
      {
        "templateRef": "wait_ticks",
        "name": "observe_resident_window",
        "ticks": 240
      },
      {
        "templateRef": "input_clear",
        "name": "clear_resident_jobs"
      }
    ]
  }
