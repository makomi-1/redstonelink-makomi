{
  "version": 1,
  "defaults": {
    "tickMillis": 50,
    "settleTicks": 20,
    "performanceWindow": {
      "totalTicks": 1600,
      "warmupTicks": 400,
      "measureTicks": 1200
    },
    "prepareFunctions": [
      "rl_bench:prepare/common",
      "rl_bench:reset/common"
    ],
    "resultsDir": "run/profiles/bench-results-performance-heavy",
    "spark": {
      "startCpu": "spark profiler start",
      "stopCpu": "spark profiler stop --comment {case_id}",
      "health": "spark health --upload --memory"
    }
  },
  "templatePaths": [
    "templates/performance/drive.json"
  ],
  "casePaths": [
    "cases/performance/p12/sync_1_to_1024_core_dense.json",
    "cases/performance/p13/toggle_1_to_1024_core_dense.json",
    "cases/performance/p14/pulse_1_to_1024_core_dense.json",
    "cases/performance/p15/sync_256_to_1_core_dense.json",
    "cases/performance/p16/toggle_256_to_1_core_dense.json",
    "cases/performance/p17/pulse_256_to_1_core_dense.json"
  ]
}
